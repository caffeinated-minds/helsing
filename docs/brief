# 5. Neovim Theme (Starter Lua)

Minimal, clean, portable base:

```lua
local helsing = {}

helsing.colors = {
  bg        = "#F4F1EA",
  bg_alt    = "#EAE5DC",
  fg        = "#2A2A2A",
  muted     = "#6B6B6B",
  subtle    = "#A8A29E",
  border    = "#D6D0C4",
  selection = "#E6DCC8",

  purple = "#7C6EE6",
  blue   = "#3A7BD5",
  green  = "#4C9A5F",
  orange = "#C47A2C",
  cyan   = "#2F8F8B",
  pink   = "#C05A8C",
  red    = "#C23B3B",
  yellow = "#B58900",
}

function helsing.setup()
  local c = helsing.colors

  vim.cmd("highlight clear")
  vim.o.background = "light"
  vim.g.colors_name = "helsing"

  local hl = vim.api.nvim_set_hl

  -- UI
  hl(0, "Normal",       { fg = c.fg, bg = c.bg })
  hl(0, "LineNr",       { fg = c.subtle })
  hl(0, "CursorLine",   { bg = c.bg_alt })
  hl(0, "Visual",       { bg = c.selection })
  hl(0, "VertSplit",    { fg = c.border })
  hl(0, "Comment",      { fg = c.muted, italic = true })

  -- Syntax
  hl(0, "Keyword",      { fg = c.purple })
  hl(0, "Function",     { fg = c.blue })
  hl(0, "String",       { fg = c.green })
  hl(0, "Number",       { fg = c.orange })
  hl(0, "Type",         { fg = c.cyan })
  hl(0, "Constant",     { fg = c.pink })

  -- Diagnostics
  hl(0, "DiagnosticError", { fg = c.red })
  hl(0, "DiagnosticWarn",  { fg = c.yellow })
end

return helsing
```

