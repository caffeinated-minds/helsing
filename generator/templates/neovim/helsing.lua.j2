-- helsing.lua
-- Generated from docs/helsing-palette.yml via generator/generate.py.
-- Do not edit this file by hand unless you are intentionally diverging from the generator.

if vim.g.colors_name then
  vim.cmd("highlight clear")
end

if vim.fn.exists("syntax_on") then
  vim.cmd("syntax reset")
end

vim.o.background = "{{ palette.variant }}"
vim.g.colors_name = "{{ palette.slug }}"

local c = {
  -- Base
  bg        = "{{ colors.bg }}",
  bg_alt    = "{{ colors.bg_alt }}",
  fg        = "{{ colors.fg }}",
  muted     = "{{ colors.muted }}",
  subtle    = "{{ colors.subtle }}",
  border    = "{{ colors.border }}",
  selection = "{{ colors.selection }}",

  -- Accents
  purple    = "{{ colors.purple }}",
  blue      = "{{ colors.blue }}",
  green     = "{{ colors.green }}",
  orange    = "{{ colors.orange }}",
  cyan      = "{{ colors.cyan }}",
  pink      = "{{ colors.pink }}",
  red       = "{{ colors.red }}",
  yellow    = "{{ colors.yellow }}",
  info      = "{{ colors.info }}",

  -- Extra UI tones
  diff_add    = "{{ colors.diff_add }}",
  diff_change = "{{ colors.diff_change }}",
  diff_delete = "{{ colors.diff_delete }}",
  search      = "{{ colors.search }}",
  incsearch   = "{{ colors.incsearch }}",
  cursorline  = "{{ colors.cursorline }}",
  linenr      = "{{ colors.linenr }}",
  visual      = "{{ colors.visual }}",
  pmenu       = "{{ colors.pmenu }}",
  pmenu_sel   = "{{ colors.pmenu_sel }}",
}

local function hl(group, opts)
  vim.api.nvim_set_hl(0, group, opts)
end

local function link(group, target)
  hl(group, { link = target })
end

local function link_many(target, groups)
  for _, group in ipairs(groups) do
    link(group, target)
  end
end

local function hl_many(groups, opts)
  for _, group in ipairs(groups) do
    hl(group, opts)
  end
end


