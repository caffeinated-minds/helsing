;;; helsing-emacs-face-contract.el --- Generated Helsing test contract -*- lexical-binding: t; -*-
;;
;; Generated from docs/helsing-palette.yml and generator/config/doom-emacs.yml.
;; Do not edit this file by hand.

(defconst helsing-test-role-aliases
  '(
{% for alias in doom_role_aliases -%}
    ({{ alias.alias }} "{{ alias.role }}" "{{ alias.token }}" "{{ alias.color }}")
{% endfor -%}
    ))

(defconst helsing-test-face-contract
  '(
{% for group in doom_face_groups -%}
{% for entry in group.entries -%}
    ({{ entry.face }}
     :layer {{ group.layer }}
{% if entry.get("foreground") -%}
     :foreground "{{ entry.foreground.color }}"
{% endif -%}
{% if entry.get("background") -%}
     :background "{{ entry.background.color }}"
{% endif -%}
{% if entry.get("inherits") -%}
     :inherit {{ entry.inherits }}
{% endif -%}
     :notes "{{ entry.notes }}")
{% endfor -%}
{% endfor -%}
    ))

(defconst helsing-test-terminal-contract
  '(
{% for entry in doom_terminal_contract -%}
    ({{ entry.name }} "{{ entry.color }}" "{{ entry.ansi256 }}" "{{ entry.tty }}")
{% endfor -%}
    ))

(provide 'helsing-emacs-face-contract)
;;; helsing-emacs-face-contract.el ends here
