strikethrough = {{ 'true' if wezterm.tab_bar.inactive_tab_hover.strikethrough else 'false' }}

[colors.tab_bar.new_tab]
bg_color = '{{ colors[wezterm.tab_bar.new_tab.bg_color] }}'
fg_color = '{{ colors[wezterm.tab_bar.new_tab.fg_color] }}'
