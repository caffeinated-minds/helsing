{
  "name": "helsing-theme",
  "displayName": "Helsing Theme",
  "description": "A scholarly daylight theme for VS Code with warm paper, graphite text and restrained semantic colour.",
  "version": "0.1.1",
  "publisher": "caffeinatedminds",
  "license": "MIT",
  "icon": "images/icon.png",
  "files": [
    "themes",
    "images",
    "LICENSE",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "theme:generate": "../../.venv/bin/python ../../generator/generate.py vscode",
    "vscode:prepublish": "npm run theme:generate",
    "check:contents": "vsce ls --tree",
    "check:release": "node scripts/check-release.mjs",
    "package:vsix": "vsce package",
    "package:vsix:pre-release": "vsce package --pre-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/caffeinated-minds/helsing.git",
    "directory": "themes/vscode"
  },
  "homepage": "https://github.com/caffeinated-minds/helsing",
  "bugs": {
    "url": "https://github.com/caffeinated-minds/helsing/issues"
  },
  "qna": "https://github.com/caffeinated-minds/helsing/issues",
  "galleryBanner": {
    "color": "#F4F1EA",
    "theme": "light"
  },
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "vsce": {
    "githubBranch": "master",
    "baseContentUrl": "https://github.com/caffeinated-minds/helsing/blob/master/themes/vscode",
    "baseImagesUrl": "https://raw.githubusercontent.com/caffeinated-minds/helsing/master/themes/vscode"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "light-theme",
    "helsing",
    "daylight",
    "warm",
    "paper",
    "minimal"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Helsing",
        "uiTheme": "vs",
        "path": "./themes/helsing-color-theme.json"
      }
    ]
  }
}
