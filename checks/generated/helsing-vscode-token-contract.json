  "scopeAllowlist": {
    "support.function": {
      "role": "function",
      "reason": "Built-in and runtime-provided callables are functions when no semantic provider is available."
    },
    "support.type": {
      "role": "type",
      "reason": "Grammar-provided built-in types are types when no semantic provider is available."
    },
    "variable": {
      "role": "variable",
      "reason": "This fallback deliberately uses the ordinary foreground, so it cannot steal an accent from a more specific rule."
    }
